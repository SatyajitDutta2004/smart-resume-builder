# Environment variables for Smart ResumeBuilder Server
# Copy this file to .env and update with your values

# Server Configuration
PORT=4001
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/smart_resumebuilder

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_2024

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:5173

# AI Backend URL
AI_BACKEND_URL=http://127.0.0.1:8000

# Optional: Add other services
# OPENAI_API_KEY=your_openai_key_if_using_openai
# SENDGRID_API_KEY=your_sendgrid_key_for_emails

# Security
BCRYPT_ROUNDS=10

# Session/Token
TOKEN_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d
