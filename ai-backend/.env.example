# Environment variables for Smart ResumeBuilder AI Backend
# Copy this file to .env and update with your values

# Server Configuration
AI_BACKEND_HOST=0.0.0.0
AI_BACKEND_PORT=8000

# Environment
ENV=development

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8080"]

# Optional: Machine Learning Model Cache
# ML_MODEL_CACHE_DIR=/tmp/ml_models
